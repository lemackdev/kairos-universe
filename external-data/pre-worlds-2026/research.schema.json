{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "league",
    "region",
    "tier",
    "expectedTeamCount",
    "sourceId",
    "sourceUrl",
    "eventName",
    "eventEndDate",
    "teams"
  ],
  "properties": {
    "league": {
      "enum": [
        "LCK",
        "LPL",
        "LEC",
        "CBLOL",
        "LCS",
        "LCP",
        "NACL"
      ]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        1,
        2
      ]
    },
    "expectedTeamCount": {
      "type": "integer",
      "minimum": 1
    },
    "sourceId": {
      "$ref": "#/definitions/id"
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://liquipedia\\.net/leagueoflegends/"
    },
    "eventName": {
      "type": "string",
      "minLength": 1
    },
    "eventEndDate": {
      "type": "string",
      "pattern": "^2026-\\d{2}-\\d{2}$"
    },
    "teams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "sourceId",
          "basis",
          "notes",
          "members"
        ],
        "properties": {
          "key": {
            "$ref": "#/definitions/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "$ref": "#/definitions/id"
          },
          "basis": {
            "enum": [
              "final-domestic-cycle",
              "last-available-domestic-tournament"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "members": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nickname",
                "role",
                "designation"
              ],
              "properties": {
                "nickname": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "top",
                    "jungle",
                    "mid",
                    "bot",
                    "support"
                  ]
                },
                "designation": {
                  "enum": [
                    "main",
                    "substitute"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
