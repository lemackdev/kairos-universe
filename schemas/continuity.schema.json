{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos-universe.local/schemas/continuity.schema.json",
  "title": "Continuity Record",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "status",
    "description",
    "canonStatus"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["active", "archived", "TBD"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "canonStatus": {
      "$ref": "common.schema.json#/$defs/canonStatus"
    }
  },
  "additionalProperties": false
}
