{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos-universe.local/schemas/game.schema.json",
  "title": "League of Legends Game Record",
  "type": "object",
  "required": [
    "id",
    "slug",
    "continuityId",
    "matchId",
    "gameNumber",
    "winnerTeamId",
    "duration",
    "patch",
    "blueTeamId",
    "redTeamId",
    "sideSelection",
    "draft",
    "picks",
    "bans",
    "playerStatistics",
    "teamStatistics",
    "sourceIds",
    "canonStatus"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "slug": { "$ref": "common.schema.json#/$defs/stableId" },
    "continuityId": { "$ref": "common.schema.json#/$defs/stableId" },
    "matchId": { "$ref": "common.schema.json#/$defs/stableId" },
    "gameNumber": { "type": "integer", "minimum": 1 },
    "winnerTeamId": { "$ref": "common.schema.json#/$defs/nullableIdOrTbd" },
    "duration": { "type": ["integer", "string", "null"] },
    "patch": { "type": ["string", "null"] },
    "blueTeamId": { "$ref": "common.schema.json#/$defs/stableId" },
    "redTeamId": { "$ref": "common.schema.json#/$defs/stableId" },
    "sideSelection": { "type": ["object", "null"] },
    "draft": { "type": ["object", "null"] },
    "picks": { "type": "array" },
    "bans": { "type": "array" },
    "playerStatistics": { "type": "array" },
    "teamStatistics": { "type": ["object", "null"] },
    "sourceIds": { "$ref": "common.schema.json#/$defs/sourceIdArray" },
    "canonStatus": { "$ref": "common.schema.json#/$defs/canonStatus" }
  },
  "additionalProperties": false
}
