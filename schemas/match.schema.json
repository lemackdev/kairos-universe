{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos-universe.local/schemas/match.schema.json",
  "title": "Match Record",
  "description": "Validates a scheduled or completed match while allowing unknown results to remain TBD.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "game",
    "status",
    "storyPeriod",
    "competition",
    "season",
    "teams",
    "scheduledDate",
    "result",
    "statistics",
    "sources",
    "confirmedFacts",
    "unconfirmedDetails",
    "canonNotes"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "slug": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "continuityId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "gameId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "game": {
      "$ref": "common.schema.json#/$defs/knownGame"
    },
    "matchType": {
      "enum": [
        "official-match",
        "showmatch",
        "private-scrim",
        "public-scrim",
        "evaluation-match",
        "internal-scrim",
        "practice-block"
      ]
    },
    "status": {
      "$ref": "common.schema.json#/$defs/knownStatus"
    },
    "storyPeriod": {
      "$ref": "common.schema.json#/$defs/stringOrTbd"
    },
    "competition": {
      "$ref": "common.schema.json#/$defs/nullableIdOrTbd"
    },
    "season": {
      "$ref": "common.schema.json#/$defs/nullableIdOrTbd"
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "scheduledDate": {
      "$ref": "common.schema.json#/$defs/stringOrTbd"
    },
    "date": {
      "$ref": "common.schema.json#/$defs/dateOrTbdOrNull"
    },
    "datePrecision": {
      "$ref": "common.schema.json#/$defs/datePrecision"
    },
    "teamAId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "teamBId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "bestOf": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "TBD"
        },
        {
          "type": "null"
        }
      ]
    },
    "teamAScore": {
      "$ref": "common.schema.json#/$defs/nonNegativeIntegerOrTbd"
    },
    "teamBScore": {
      "$ref": "common.schema.json#/$defs/nonNegativeIntegerOrTbd"
    },
    "winnerTeamId": {
      "$ref": "common.schema.json#/$defs/nullableIdOrTbd"
    },
    "visibility": {
      "enum": ["public", "private", "internal"]
    },
    "officialStatus": {
      "enum": ["official", "unofficial", "practice"]
    },
    "result": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "const": "TBD"
        },
        {
          "type": "null"
        }
      ]
    },
    "statistics": {
      "$ref": "common.schema.json#/$defs/openObject"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/stringArray"
    },
    "sourceIds": {
      "$ref": "common.schema.json#/$defs/sourceIdArray"
    },
    "canonStatus": {
      "$ref": "common.schema.json#/$defs/canonStatus"
    },
    "confirmedFacts": {
      "$ref": "common.schema.json#/$defs/canonTextArray"
    },
    "unconfirmedDetails": {
      "$ref": "common.schema.json#/$defs/canonTextArray"
    },
    "canonNotes": {
      "$ref": "common.schema.json#/$defs/canonTextArray"
    }
  },
  "additionalProperties": false
}
