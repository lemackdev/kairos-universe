{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos-universe.local/schemas/ruleset.schema.json",
  "title": "Competitive Ruleset Record",
  "description": "A reusable, global competitive rule (e.g. a map pool) that applies across tiers, teams, and organizers rather than being duplicated per-competition.",
  "type": "object",
  "required": ["id", "slug", "continuityId", "gameId", "rulesetType", "name", "scope", "status", "effectiveDate", "sourceIds", "canonStatus", "notes"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "slug": { "$ref": "common.schema.json#/$defs/stableId" },
    "continuityId": { "$ref": "common.schema.json#/$defs/stableId" },
    "gameId": { "$ref": "common.schema.json#/$defs/stableId" },
    "rulesetType": { "enum": ["map-pool"] },
    "name": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["global"] },
    "status": { "enum": ["active", "retired", "planned"] },
    "effectiveDate": { "$ref": "common.schema.json#/$defs/dateOrTbd" },
    "endDate": { "$ref": "common.schema.json#/$defs/dateOrTbdOrNull" },
    "rotation": { "enum": ["none", "periodic"] },
    "maps": { "$ref": "common.schema.json#/$defs/stringArray" },
    "excludedMaps": { "$ref": "common.schema.json#/$defs/stringArray" },
    "appliesTo": { "type": "string", "minLength": 1 },
    "sourceIds": { "$ref": "common.schema.json#/$defs/sourceIdArray" },
    "canonStatus": { "$ref": "common.schema.json#/$defs/canonStatus" },
    "notes": { "$ref": "common.schema.json#/$defs/stringArray" }
  },
  "additionalProperties": false
}
