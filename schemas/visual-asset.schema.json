{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairos-universe.local/schemas/visual-asset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "path",
    "mimeType",
    "organizationId",
    "season",
    "category",
    "orientation",
    "color",
    "canonStatus",
    "teamIds",
    "source",
    "importDate",
    "width",
    "height",
    "sha256",
    "referencePath",
    "referenceSha256",
    "processing",
    "garmentHeight",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^assets/.+\\.png$"
    },
    "mimeType": {
      "const": "image/png"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "season": {
      "type": [
        "integer",
        "null"
      ]
    },
    "category": {
      "enum": [
        "logo",
        "uniform"
      ]
    },
    "orientation": {
      "enum": [
        "logo",
        "front",
        "back"
      ]
    },
    "color": {
      "type": "string"
    },
    "canonStatus": {
      "enum": [
        "confirmed",
        "approved-future-canon"
      ]
    },
    "teamIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "source": {
      "const": "user-approved-generated-asset"
    },
    "importDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "referencePath": {
      "type": "string",
      "pattern": "^assets/.+\\.png$"
    },
    "referenceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "processing": {
      "type": "string"
    },
    "garmentHeight": {
      "type": [
        "integer",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
